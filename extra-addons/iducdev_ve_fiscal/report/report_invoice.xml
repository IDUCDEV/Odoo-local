<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Vista QWeb heredada: no debe declarar "model" (el padre tampoco lo
         tiene) o la herencia no se combina. -->
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <!-- Datos de emisión fiscal junto a la fecha (art. 8.3 y 8.5) -->
        <xpath expr="//div[@id='informations']/div[@name='invoice_date']" position="after">
            <div
                class="col"
                name="ve_fiscal_number"
                t-if="o.x_fiscal_number and o.move_type in ('out_invoice', 'out_refund')"
            >
                <strong>N° Factura Fiscal</strong>
                <div t-out="o.x_fiscal_number" />
            </div>
            <div
                class="col"
                name="ve_control_number"
                t-if="o.x_control_number and o.move_type in ('out_invoice', 'out_refund')"
            >
                <strong>N° de Control</strong>
                <div t-out="o.x_control_number" />
            </div>
            <div
                class="col"
                name="ve_fiscal_datetime"
                t-if="o.x_fiscal_datetime and o.move_type in ('out_invoice', 'out_refund')"
            >
                <strong>Fecha y hora de emisión</strong>
                <div>
                    <span
                        t-field="o.x_fiscal_datetime"
                        t-options='{"format": "ddMMyyyy HH.mm.ss a"}'
                    />
                </div>
            </div>
        </xpath>

        <!-- Marca (E) en líneas exentas, exoneradas o no gravadas (art. 8.7) -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="inside">
            <t
                t-if="o.move_type in ('out_invoice', 'out_refund') and not any(line.tax_ids.mapped('amount'))"
            >(E) </t>
        </xpath>

        <!-- Tipo de cambio y total en bolívares cuando se factura en divisa (art. 8.12) -->
        <xpath expr="//div[@id='total']" position="after">
            <div
                name="ve_currency_totals"
                class="mt-2"
                t-if="o.move_type in ('out_invoice', 'out_refund') and o.x_ve_currency_id and o.currency_id != o.x_ve_currency_id and o.x_ve_amount_total"
            >
                <table class="o_total_table table table-borderless table-sm mb-0">
                    <tr>
                        <td class="text-muted">Tipo de cambio aplicado</td>
                        <td class="text-end">
                            <span
                                t-out="o.x_ve_rate_used"
                                t-options='{"widget": "float", "precision": 6}'
                            />
                            <span t-out="o.x_ve_currency_id.name" /> / 1
                            <span t-out="o.currency_id.name" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <strong>Total en <span t-out="o.x_ve_currency_id.name" /></strong>
                        </td>
                        <td class="text-end">
                            <strong t-field="o.x_ve_amount_total" />
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>

        <!-- Frase obligatoria y aviso de contingencia (art. 19 y art. 11.3) -->
        <xpath expr="//div[@id='payment_term']" position="after">
            <div
                name="ve_legal_note"
                class="mt-3"
                t-if="o.move_type in ('out_invoice', 'out_refund')"
            >
                <p class="mb-1">
                    <small>Documento emitido conforme a la Providencia Administrativa
                        SNAT/2026/00093 (Gaceta Oficial N° 43.484 del 21/10/2026).</small>
                </p>
                <p class="mb-1" t-if="o.x_fiscal_medium == 'contingencia'">
                    <small><strong>Emitido en formato de contingencia.</strong>
                        Las copias de este documento no dan derecho a crédito fiscal.</small>
                </p>
            </div>
        </xpath>
    </template>
</odoo>
