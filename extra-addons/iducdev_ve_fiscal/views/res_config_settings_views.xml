<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.iducdev.ve.fiscal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='display_invoice_tax_company_currency']"
                position="after"
            >
                <setting
                    id="ve_fiscal_enforcement"
                    company_dependent="1"
                    help="No permitir validar facturas de clientes sin número de control y fecha/hora de emisión fiscal (Providencia SNAT/2026/00093)"
                >
                    <field name="x_ve_fiscal_enforcement" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
