<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.iducdev.ve.fiscal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@id='other_tab']/group[@id='other_tab_group']"
                position="inside"
            >
                <group
                    string="SENIAT (Venezuela)"
                    name="ve_fiscal_group"
                    invisible="move_type not in ('out_invoice', 'out_refund')"
                >
                    <field
                        name="x_ve_tax_warning"
                        colspan="2"
                        readonly="1"
                        class="text-danger fw-bold"
                        invisible="not x_ve_tax_warning"
                    />
                    <group name="ve_fiscal_emission">
                        <field name="x_fiscal_medium" />
                        <field name="x_fiscal_number" />
                        <field name="x_control_number" />
                        <field name="x_fiscal_datetime" />
                        <field name="x_fiscal_state" />
                    </group>
                    <group name="ve_fiscal_currency">
                        <field name="x_seniat_rate" />
                        <field name="x_ve_currency_id" groups="base.group_no_one" />
                        <field name="x_ve_rate_used" readonly="1" />
                        <field name="x_ve_amount_total" readonly="1" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.move.search.iducdev.ve.fiscal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
                    name="ve_fiscal_pending"
                    string="Sin datos fiscales SENIAT"
                    domain="[('x_fiscal_state', '=', 'pending'), ('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '=', 'posted')]"
                />
                <filter
                    name="ve_fiscal_contingency"
                    string="Contingencia por remitir"
                    domain="[('x_fiscal_state', '=', 'contingency')]"
                />
                <filter
                    name="ve_fiscal_issued"
                    string="Emitidas al SENIAT"
                    domain="[('x_fiscal_state', '=', 'issued')]"
                />
                <field name="x_control_number" />
                <field name="x_fiscal_number" />
            </xpath>
        </field>
    </record>
</odoo>
